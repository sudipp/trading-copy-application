# Server Configuration
PORT=3001
NODE_ENV=development

# Supabase Database Configuration
# Option 1: Use connection string (recommended)
# Get this from your Supabase project settings > Database > Connection string > URI
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@[PROJECT-REF].supabase.co:5432/postgres

# Option 2: Use individual parameters (alternative)
# DB_HOST=[PROJECT-REF].supabase.co
# DB_PORT=5432
# DB_NAME=postgres
# DB_USER=postgres
# DB_PASSWORD=[YOUR-PASSWORD]
# DB_SSL=true

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

# OAuth Configuration
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
APPLE_CLIENT_ID=your-apple-client-id
APPLE_TEAM_ID=your-apple-team-id
APPLE_KEY_ID=your-apple-key-id
APPLE_PRIVATE_KEY_LOCATION=./config/apple-key.p8

# Stock Data API Configuration
STOCK_API_KEY=your-stock-api-key
STOCK_API_PROVIDER=alpha-vantage

# Frontend URL (for CORS and OAuth redirects)
FRONTEND_URL=http://localhost:5173
API_URL=http://localhost:3001

# Email Configuration (for password reset)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM="Trading Copy App" <noreply@tradingcopy.com>
